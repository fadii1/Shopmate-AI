# Khareed - Environment Configuration
APP_NAME=Khareed
APP_ENV=development
DEBUG=True
PORT=8000
HOST=127.0.0.1

# Anthropic Claude API Key (optional for mock/offline testing, required for live Claude agent)
ANTHROPIC_API_KEY=

# Database: PostgreSQL 18
# Format: postgresql+asyncpg://postgres:<YOUR_POSTGRES_PASSWORD>@localhost:5432/khareed
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/khareed

# FX Settings (PKR conversion)
USD_TO_PKR_RATE=278.50
FX_RATE_DATE=2026-11-21

# Notification Channels (for price-drop & restock alerts)
NOTIFICATION_CHANNEL=console  # Options: console, email, webhook, telegram
NOTIFICATION_WEBHOOK_URL=
ALERT_EMAIL_FROM=alerts@khareed.pk
